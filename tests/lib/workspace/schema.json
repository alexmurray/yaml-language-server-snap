{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pet",
  "description": "A pet and its details",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "The name of the pet"
    },
    "kind": {
      "type": "string",
      "enum": ["cat", "dog", "fish"],
      "description": "What sort of animal the pet is"
    },
    "age": {
      "type": "integer",
      "description": "The age of the pet in years"
    }
  },
  "required": ["name", "kind"],
  "additionalProperties": false
}
